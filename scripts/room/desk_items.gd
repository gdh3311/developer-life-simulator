extends RefCounted
## Desk item assets: which keyboard, mouse, mug and plant sit on the desk.
## Built-in items come from res://content/desk/catalog.json (generated by tools/gen_desk_assets.py).
## Custom items: put <name>.json + an image (PNG or SVG) in user://desk_assets/ — see content/desk/README.md.
## Equipped items live in Game.state["desk"] = { slot: item_id }.

const CATALOG := "res://content/desk/catalog.json"
const CUSTOM_DIR := "user://desk_assets"

static var _catalog := {}
static var _textures := {}


static func t(ko: String, en: String) -> Dictionary:
	return {"ko": ko, "en": en}


static func catalog() -> Dictionary:
	if _catalog.is_empty():
		reload()
	return _catalog


## Re-read the built-in catalog and the player's custom items.
static func reload() -> void:
	var data = JSON.parse_string(FileAccess.get_file_as_string(CATALOG))
	_catalog = data if typeof(data) == TYPE_DICTIONARY else {"slots": {}, "items": []}
	_textures.clear()
	for item in _custom_items():
		_catalog["items"].append(item)


static func _custom_items() -> Array:
	var result: Array = []
	if not DirAccess.dir_exists_absolute(CUSTOM_DIR):
		return result
	for f in DirAccess.get_files_at(CUSTOM_DIR):
		if not f.ends_with(".json"):
			continue
		var raw = JSON.parse_string(FileAccess.get_file_as_string(CUSTOM_DIR.path_join(f)))
		if typeof(raw) != TYPE_DICTIONARY:
			continue
		var slot := String(raw.get("slot", ""))
		var image := String(raw.get("image", ""))
		var size = raw.get("size", [])
		if not _catalog["slots"].has(slot) or image == "" or image.contains("..") or typeof(size) != TYPE_ARRAY or size.size() != 2:
			continue
		var name = raw.get("name", f.get_basename())
		result.append({
			"id": "custom_" + f.get_basename(), "slot": slot, "custom": true,
			"name": name if typeof(name) == TYPE_DICTIONARY else {"ko": str(name), "en": str(name)},
			"file": CUSTOM_DIR.path_join(image), "size": [clampf(float(size[0]), 8, 900), clampf(float(size[1]), 8, 400)], "unlock": {},
		})
	return result


static func slots() -> Array:
	return catalog()["slots"].keys()


static func slot_info(slot: String) -> Dictionary:
	return catalog()["slots"].get(slot, {})


static func item(id: String) -> Dictionary:
	for it in catalog()["items"]:
		if it["id"] == id:
			return it
	return {}


static func items_for(slot: String) -> Array:
	return catalog()["items"].filter(func(it: Dictionary) -> bool: return it["slot"] == slot)


static func _state() -> Dictionary:
	if not Game.state.has("desk") or typeof(Game.state["desk"]) != TYPE_DICTIONARY:
		Game.state["desk"] = {}
	return Game.state["desk"]


static func equipped(slot: String) -> Dictionary:
	var id := String(_state().get(slot, ""))
	if id == "":
		# Nothing chosen yet (e.g. older saves): something you bought beats the default.
		for candidate in items_for(slot):
			if candidate.get("unlock", {}).has("owned") and unlocked(candidate):
				return candidate
	var it := item(id)
	if it.is_empty() or it["slot"] != slot or not unlocked(it):
		it = item(String(slot_info(slot).get("default", "")))
	return it


## Unlock rules: owned (bought in the shop), rank (reached), story (mission done). Custom items are free.
static func unlocked(it: Dictionary) -> bool:
	var u: Dictionary = it.get("unlock", {})
	if u.has("owned") and not Game.state["owned"].has(u["owned"]):
		return false
	if u.has("rank") and int(Game.state["rank"]) < int(u["rank"]):
		return false
	if u.has("story") and String(Game.state["story"].get(u["story"], {}).get("status", "")) != "done":
		return false
	return true


static func lock_reason(it: Dictionary) -> String:
	var u: Dictionary = it.get("unlock", {})
	if u.has("owned"):
		return Game.L("Shoply에서 구매하면 열림", "Unlocks with a Shoply purchase")
	if u.has("rank"):
		return Game.L("%s 이상" % Game.tx(Game.RANKS[clampi(int(u["rank"]), 0, Game.RANKS.size() - 1)]), "%s or above" % Game.tx(Game.RANKS[clampi(int(u["rank"]), 0, Game.RANKS.size() - 1)]))
	if u.has("story"):
		return Game.L("이야기를 진행하면 열림", "Unlocks as the story continues")
	return ""


static func equip(slot: String, id: String) -> bool:
	var it := item(id)
	if it.is_empty() or it["slot"] != slot or not unlocked(it):
		return false
	_state()[slot] = id
	Game.emit_event("desk_changed", {"slot": slot, "item": id})
	Game.save_soon()
	return true


static func texture(it: Dictionary) -> Texture2D:
	var path := String(it.get("file", ""))
	if path == "":
		return null
	if _textures.has(path):
		return _textures[path]
	var tex: Texture2D = null
	if path.begins_with("res://"):
		tex = load(path) as Texture2D
	else:
		var img := Image.new()
		var ok := ERR_FILE_CANT_OPEN
		if path.get_extension().to_lower() == "svg":
			ok = img.load_svg_from_buffer(FileAccess.get_file_as_bytes(path), 2.0)
		else:
			ok = img.load(path)
		if ok == OK:
			tex = ImageTexture.create_from_image(img)
	_textures[path] = tex
	return tex


## Where an item is drawn for its slot (room coordinates).
static func rect_for(it: Dictionary) -> Rect2:
	var info := slot_info(String(it["slot"]))
	var anchor := Vector2(float(info["anchor"][0]), float(info["anchor"][1]))
	var size := Vector2(float(it["size"][0]), float(it["size"][1]))
	if String(info.get("origin", "center")) == "bottom":
		return Rect2(anchor - Vector2(size.x / 2.0, size.y), size)
	return Rect2(anchor - size / 2.0, size)
