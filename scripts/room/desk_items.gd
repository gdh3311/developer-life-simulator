extends RefCounted
## Desk item assets: which keyboard, mouse, mug and plant sit on the desk.
## Built-in items come from res://content/desk/catalog.json (generated by tools/gen_desk_assets.py).
## Custom items: put <name>.json + an image (PNG or SVG) in user://desk_assets/ — see content/desk/README.md.
## Equipped items live in Game.state["desk"] = { slot: item_id }.

const CATALOG := "res://content/desk/catalog.json"
const CUSTOM_DIR := "user://desk_assets"

static var _catalog := {}
static var _textures := {}


static func t(ko: String, en: String) -> Dictionary:
	return {"ko": ko, "en": en}


static func catalog() -> Dictionary:
	if _catalog.is_empty():
		reload()
	return _catalog


## Re-read the built-in catalog and the player's custom items.
static func reload() -> void:
	var data = JSON.parse_string(FileAccess.get_file_as_string(CATALOG))
	_catalog = data if typeof(data) == TYPE_DICTIONARY else {"slots": {}, "items": []}
	_textures.clear()
	for item in _custom_items():
		_catalog["items"].append(item)


static func _custom_items() -> Array:
	var result: Array = []
	if not DirAccess.dir_exists_absolute(CUSTOM_DIR):
		return result
	for f in DirAccess.get_files_at(CUSTOM_DIR):
		if not f.ends_with(".json"):
			continue
		var raw = JSON.parse_string(FileAccess.get_file_as_string(CUSTOM_DIR.path_join(f)))
		if typeof(raw) != TYPE_DICTIONARY:
			continue
		var slot := String(raw.get("slot", ""))
		var image := String(raw.get("image", ""))
		var size = raw.get("size", [])
		if not _catalog["slots"].has(slot) or image == "" or image.contains("..") or typeof(size) != TYPE_ARRAY or size.size() != 2:
			continue
		var name = raw.get("name", f.get_basename())
		result.append({
			"id": "custom_" + f.get_basename(), "slot": slot, "custom": true,
			"name": name if typeof(name) == TYPE_DICTIONARY else {"ko": str(name), "en": str(name)},
			"file": CUSTOM_DIR.path_join(image), "size": [clampf(float(size[0]), 8, 900), clampf(float(size[1]), 8, 400)], "unlock": {},
		})
	return result


static func slots() -> Array:
	return catalog()["slots"].keys()


static func slot_info(slot: String) -> Dictionary:
	return catalog()["slots"].get(slot, {})


static func item(id: String) -> Dictionary:
	for it in catalog()["items"]:
		if it["id"] == id:
			return it
	return {}


static func items_for(slot: String) -> Array:
	return catalog()["items"].filter(func(it: Dictionary) -> bool: return it["slot"] == slot)


static func _state() -> Dictionary:
	if not Game.state.has("desk") or typeof(Game.state["desk"]) != TYPE_DICTIONARY:
		Game.state["desk"] = {}
	return Game.state["desk"]


static func equipped(slot: String) -> Dictionary:
	var id := String(_state().get(slot, ""))
	if id == "":
		# Nothing chosen yet (e.g. older saves): something you bought beats the default.
		for candidate in items_for(slot):
			if candidate.get("unlock", {}).has("owned") and unlocked(candidate):
				return candidate
	var it := item(id)
	if it.is_empty() or it["slot"] != slot or not unlocked(it):
		it = item(String(slot_info(slot).get("default", "")))
	return it


## Unlock rules: owned (bought in the shop), rank (reached), story (mission done), achievement,
## tickets (small tickets finished), stat [key, n]. Custom items are free.
static func unlocked(it: Dictionary) -> bool:
	var u: Dictionary = it.get("unlock", {})
	if u.has("owned") and not Game.state["owned"].has(u["owned"]):
		return false
	if u.has("rank") and int(Game.state["rank"]) < int(u["rank"]):
		return false
	if u.has("story") and String(Game.state["story"].get(u["story"], {}).get("status", "")) != "done":
		return false
	if u.has("achievement") and not (Story.career != null and Story.career.unlocked(String(u["achievement"]))):
		return false
	if u.has("tickets") and _tickets_done() < int(u["tickets"]):
		return false
	if u.has("stat") and Game.stat(String(u["stat"][0])) < int(u["stat"][1]):
		return false
	return true


static func _tickets_done() -> int:
	var t = Game.state.get("tickets", {})
	return (t.get("done", {}) as Dictionary).size() if t is Dictionary else 0


static func lock_reason(it: Dictionary) -> String:
	var u: Dictionary = it.get("unlock", {})
	if u.has("owned"):
		return Game.L("Shoply에서 구매하면 열림", "Unlocks with a Shoply purchase")
	if u.has("rank"):
		return Game.L("%s 이상" % Game.tx(Game.RANKS[clampi(int(u["rank"]), 0, Game.RANKS.size() - 1)]), "%s or above" % Game.tx(Game.RANKS[clampi(int(u["rank"]), 0, Game.RANKS.size() - 1)]))
	if u.has("story"):
		return Game.L("이야기를 진행하면 열림", "Unlocks as the story continues")
	if u.has("achievement"):
		var a: Dictionary = Story.career.ACHIEVEMENTS.get(String(u["achievement"]), {}) if Story.career != null else {}
		return Game.L("업적 '%s'", "Achievement '%s'") % (Game.tx(a["name"]) if a.has("name") else String(u["achievement"]))
	if u.has("tickets"):
		return Game.L("작은 일감 %d개 완료 (%d/%d)", "Finish %d small tickets (%d/%d)") % [int(u["tickets"]), mini(_tickets_done(), int(u["tickets"])), int(u["tickets"])]
	if u.has("stat"):
		var names := {"ai_used": Game.L("AICode에 맡기기", "Delegate to AICode"), "prs": Game.L("PR 만들기", "Open PRs"), "reviews": Game.L("리뷰하기", "Review")}
		var have := mini(Game.stat(String(u["stat"][0])), int(u["stat"][1]))
		return "%s %d/%d" % [names.get(String(u["stat"][0]), String(u["stat"][0])), have, int(u["stat"][1])]
	return ""


# --- Decor: collectible toys placed freely on the desk ------------------------------------------------

const MAX_DECOR := 6
const DECOR_AREA := Rect2(40, 905, 1840, 165)   # where a toy's base may stand (room coordinates)


static func decor_items() -> Array:
	return items_for("decor")


## Placed props: [{id, x, y, angle}] with a room-space base and an optional yaw for older saves.
static func placed() -> Array:
	var d := _state()
	if typeof(d.get("decor")) != TYPE_ARRAY:
		d["decor"] = []
	return d["decor"]


static func is_placed(id: String) -> bool:
	return placed().any(func(p: Dictionary) -> bool: return p["id"] == id)


static func clamp_spot(spot: Vector2) -> Vector2:
	return Vector2(clampf(spot.x, DECOR_AREA.position.x, DECOR_AREA.end.x), clampf(spot.y, DECOR_AREA.position.y, DECOR_AREA.end.y))


static func place(id: String, spot: Vector2, angle: float = 0.0) -> bool:
	var it := item(id)
	if it.is_empty() or it["slot"] != "decor" or not unlocked(it):
		return false
	spot = clamp_spot(spot).snapped(Vector2(0.25, 0.25))
	for p in placed():
		if p["id"] == id:
			p["x"] = spot.x
			p["y"] = spot.y
			p["angle"] = wrapf(angle, -180.0, 180.0)
			_changed("decor", id)
			return true
	if placed().size() >= MAX_DECOR:
		return false
	placed().append({"id": id, "x": spot.x, "y": spot.y, "angle": wrapf(angle, -180.0, 180.0)})
	_changed("decor", id)
	return true


static func remove(id: String) -> void:
	_state()["decor"] = placed().filter(func(p: Dictionary) -> bool: return p["id"] != id)
	_changed("decor", id)


static func lamp_on() -> bool:
	return bool(_state().get("lamp_on", true))


static func set_lamp(on: bool) -> void:
	_state()["lamp_on"] = on
	_changed("decor", "decor_task_lamp")


## Swap a matching set in one save, respecting its existing unlocks.
static func equip_set(items: Dictionary) -> bool:
	for slot in items:
		var candidate := item(items[slot])
		if candidate.is_empty() or candidate["slot"] != slot or not unlocked(candidate):
			return false
	_state().merge(items, true)
	_changed("set", "")
	return true


static func _changed(slot: String, id: String) -> void:
	Game.emit_event("desk_changed", {"slot": slot, "item": id})
	Game.save_soon()


## Toys further back on the desk look a little smaller.
static func decor_rect(it: Dictionary, spot: Vector2) -> Rect2:
	var depth := clampf((spot.y - DECOR_AREA.position.y) / DECOR_AREA.size.y, 0.0, 1.0)
	var size := Vector2(float(it["size"][0]), float(it["size"][1])) * lerpf(0.86, 1.08, depth)
	return Rect2(spot - Vector2(size.x / 2.0, size.y), size)


## Cycle a slot to its next unlocked item (decorating mode: click the keyboard to try the next one).
static func cycle(slot: String) -> String:
	var options := items_for(slot).filter(func(it: Dictionary) -> bool: return unlocked(it))
	if options.is_empty():
		return ""
	var current := String(equipped(slot).get("id", ""))
	var i := options.map(func(it: Dictionary) -> String: return it["id"]).find(current)
	var next: Dictionary = options[(i + 1) % options.size()]
	equip(slot, next["id"])
	return next["id"]


## Items that became available since the player last looked (for the "new toy!" notice).
static func newly_unlocked() -> Array:
	var d := _state()
	var seen: Array = d.get("seen", [])
	var fresh: Array = []
	for it in catalog()["items"]:
		if unlocked(it) and not it.get("custom", false) and not (it["id"] in seen):
			fresh.append(it)
	for it in fresh:
		seen.append(it["id"])
	d["seen"] = seen
	if not d.get("seen_init", false):
		d["seen_init"] = true   # the first look just records what's already there
		return []
	return fresh


static func equip(slot: String, id: String) -> bool:
	var it := item(id)
	if it.is_empty() or it["slot"] != slot or not unlocked(it):
		return false
	_state()[slot] = id
	Game.emit_event("desk_changed", {"slot": slot, "item": id})
	Game.save_soon()
	return true


static func texture(it: Dictionary) -> Texture2D:
	var path := String(it.get("file", ""))
	if path == "":
		return null
	if _textures.has(path):
		return _textures[path]
	var tex: Texture2D = null
	if path.begins_with("res://"):
		tex = load(path) as Texture2D
	else:
		var img := Image.new()
		var ok := ERR_FILE_CANT_OPEN
		if path.get_extension().to_lower() == "svg":
			ok = img.load_svg_from_buffer(FileAccess.get_file_as_bytes(path), 2.0)
		else:
			ok = img.load(path)
		if ok == OK:
			tex = ImageTexture.create_from_image(img)
	_textures[path] = tex
	return tex


## Where an item is drawn for its slot (room coordinates).
static func rect_for(it: Dictionary) -> Rect2:
	var info := slot_info(String(it["slot"]))
	var anchor := Vector2(float(info["anchor"][0]), float(info["anchor"][1]))
	var size := Vector2(float(it["size"][0]), float(it["size"][1]))
	if String(info.get("origin", "center")) == "bottom":
		return Rect2(anchor - Vector2(size.x / 2.0, size.y), size)
	return Rect2(anchor - size / 2.0, size)
